---
interface Props {
  mode?: 'pro' | 'personal';
}
const { mode = 'pro' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

  <div id="game" class="has-title" data-base={base} data-mode={mode}>
    <div class="stars" aria-hidden="true"></div>
    <div id="stage" aria-label="A voxel world of Basil's journey. Use the next and back buttons or arrow keys to travel."></div>
    <div id="bubbles" aria-live="polite"></div>
    <div class="scan" aria-hidden="true"></div>

    <header class="hud">
      <a class="brand hud__brand" href={base}><span class="brand__mark pxcorners" aria-hidden="true"></span><span class="brand__name">Basil Khan</span></a>
      <nav class="hud__nav" aria-label="Main">
        <a class="pxbtn pxbtn--white pxbtn--sm" href={`${base}work/`}>Work</a>
        <a class="pxbtn pxbtn--white pxbtn--sm" href={`${base}thoughts/`}>Thoughts</a>
        <a class="pxbtn pxbtn--pink pxbtn--sm" href={`${base}contact/`}>Contact</a>
      </nav>
    </header>

    <div class="score" aria-hidden="true">
      <div id="year">2026</div>
      <div id="tape"></div>
    </div>

    <div id="title">
      <h1 class="logo"><span>Basil</span><span>Khan</span></h1>
      <p class="title__sub">Co-founder &amp; CTO at Freshly Commerce</p>
      <div class="title__btns">
        <button id="rewind" class="pxbtn pxbtn--white">◀◀ Where we've been</button>
        <button id="start" class="pxbtn">Where we're going ▶</button>
      </div>
      <p class="title__hint">Arrow keys, swipe, or tap to travel</p>
    </div>

    <div class="dock">
      <section id="card" class="panel pxcorners" aria-live="polite"></section>
      <button id="card-tab" class="card-tab" type="button" aria-controls="card" aria-expanded="false" hidden>Info</button>
      <div class="controls">
        <button id="prev" class="pxbtn pxbtn--white" aria-label="Previous stop">◀ <small id="prev-label"></small></button>
        <button id="next" class="pxbtn" aria-label="Next stop"><small id="next-label"></small> ▶</button>
      </div>
      <nav id="track" aria-label="Stops"></nav>
    </div>

    <section class="sr-only" aria-label="About Basil Khan">
      <h2>About Basil</h2>
      <p>
        Basil Khan is co-founder and CTO of Freshly Commerce, which builds Simple Bundles, Simple Discounts and
        Freshly Inventory, Shopify apps used by 25,000 merchants including Glossier, STANLEY and Yamaha. Freshly
        started with a 3rd place finish in Shopify's 2020 App Challenge. Before that Basil built software at
        Podia, AsteroidX, Vidyard and LANSA, after studying Chemical Engineering at the University of Waterloo.
      </p>
      <ul>
        <li><a href={`${base}work/`}>Freshly Commerce products</a></li>
        <li><a href={`${base}journey/`}>The journey, as text</a></li>
        <li><a href={`${base}thoughts/`}>Thoughts</a></li>
        <li><a href={`${base}contact/`}>Contact</a></li>
      </ul>
    </section>

    <noscript>
      <div class="noscript panel">This page is a little 3D world and needs JavaScript. <a href={`${base}journey/`}>Read the text version.</a></div>
    </noscript>
    <a class="skip" href={`${base}journey/`}>Text version</a>
    {mode === 'personal' ? (
      <a class="route-badge" href={base} title="Back to the professional journey">♥ Personal journey · switch back</a>
    ) : (
      <div id="hatched" class="hatched panel pxcorners" role="dialog" aria-label="Easter egg found" hidden>
        <p class="hatched__title">You found the Easter egg!</p>
        <p class="hatched__body">It hatched into the personal version of the journey.</p>
        <div class="hatched__btns">
          <a class="pxbtn pxbtn--pink pxbtn--sm" href={`${base}personal/`}>See the personal journey</a>
          <button class="pxbtn pxbtn--white pxbtn--sm" type="button" data-close>Keep exploring</button>
        </div>
      </div>
    )}
  </div>


<script>
  import { startGame } from '../game/engine.js';
  const el = document.getElementById('game');
  startGame(el).catch((e) => {
    console.error(e);
    el.classList.add('is-broken');
  });
</script>

<style is:global>
  html, body { height: 100%; overflow: hidden; overscroll-behavior: none; }
  #game {
    position: fixed;
    inset: 0;
    background: var(--sky);
    transition: background-color 1.2s ease;
    overflow: hidden;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  #game.is-past { --grain: 1; }
  #stage { position: absolute; inset: 0; }
  #stage canvas { display: block; width: 100%; height: 100%; }
  #game.is-past #stage canvas { filter: sepia(0.35) saturate(1.1); }

  .stars {
    position: absolute; inset: 0; opacity: 0; transition: opacity 2s;
    background-image:
      radial-gradient(2px 2px at 20% 30%, #fff 50%, transparent 51%),
      radial-gradient(2px 2px at 70% 20%, #fff 50%, transparent 51%),
      radial-gradient(3px 3px at 40% 70%, #ffe14d 50%, transparent 51%),
      radial-gradient(2px 2px at 85% 60%, #fff 50%, transparent 51%),
      radial-gradient(2px 2px at 10% 85%, #fff 50%, transparent 51%),
      radial-gradient(2px 2px at 55% 45%, #bff0ff 50%, transparent 51%);
    background-size: 240px 240px;
    image-rendering: pixelated;
  }
  #game.is-space .stars { opacity: 1; animation: twinkle 3s steps(2) infinite; }
  @keyframes twinkle { 50% { background-position: 1px 0; opacity: 0.8; } }

  /* VHS scanlines while rewinding */
  .scan { position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 0.2s;
    background: repeating-linear-gradient(0deg, rgba(0,0,0,0.12) 0 2px, transparent 2px 4px); }
  #game.is-moving:has(#tape[data-mode='rewind']) .scan { opacity: 1; }

  .hud {
    position: absolute; top: 0; left: 0; right: 0;
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
    padding: max(14px, env(safe-area-inset-top)) 16px 0;
    pointer-events: none;
  }
  .hud > * { pointer-events: auto; }
  .hud__brand { background: #fff; border: 3px solid var(--ink); padding: 8px 12px; box-shadow: var(--shadow); font-size: 12px; }
  .hud__nav { display: flex; gap: 10px; }

  .score { position: absolute; top: 78px; left: 18px; pointer-events: none; }
  #year {
    font-family: var(--px); font-size: clamp(28px, 5vw, 44px); color: #fff;
    text-shadow: 3px 3px 0 var(--ink), -3px -3px 0 var(--ink), 3px -3px 0 var(--ink), -3px 3px 0 var(--ink), 0 6px 0 var(--ink);
  }
  #tape { font-family: var(--px); font-size: 11px; margin-top: 10px; color: #fff; background: var(--ink); display: inline-block; padding: 6px 8px; opacity: 0; }
  #game.is-moving #tape { opacity: 1; animation: blink 0.8s steps(2) infinite; }
  #tape[data-mode='rewind'] { background: var(--pink); }
  #tape[data-mode='ffwd'] { background: var(--purple); }
  @keyframes blink { 50% { opacity: 0.4; } }

  /* Title screen, Crossy Road style block letters */
  #title {
    position: absolute; left: 50%; top: 40%; transform: translate(-50%, -50%);
    text-align: center; width: min(92vw, 640px);
    transition: opacity 0.4s, transform 0.4s;
  }
  #title.is-hidden { opacity: 0; transform: translate(-50%, -60%); pointer-events: none; }
  .logo { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .logo span {
    display: inline-block; font-size: clamp(34px, 9vw, 76px); color: #fff; background: var(--ink);
    padding: 14px 18px 10px; line-height: 1; transform: rotate(-4deg);
    text-shadow: 0 5px 0 #9aa0a8;
    box-shadow: 8px 8px 0 rgba(0,0,0,0.25);
  }
  .logo span + span { transform: rotate(-4deg) translateX(8%); }
  .title__sub { font-family: var(--px); font-size: clamp(10px, 2.2vw, 13px); background: var(--yellow); display: inline-block; padding: 8px 10px; border: 3px solid var(--ink); margin: 26px 0 18px; }
  .title__btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .title__hint { font-family: var(--px); font-size: 9px; color: var(--ink); opacity: 0.7; margin-top: 18px; }

  .dock {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 0 16px max(14px, env(safe-area-inset-bottom));
    display: grid; grid-template-columns: minmax(0, 400px) 1fr auto; grid-template-areas: 'card . controls' 'track track track';
    align-items: end; gap: 12px 16px;
    pointer-events: none; transition: opacity 0.4s;
  }
  .dock > * { pointer-events: auto; }
  #game.has-title .dock { opacity: 0; pointer-events: none; }
  #game.has-title .dock > * { pointer-events: none; }
  #game.has-title #bubbles { opacity: 0; }

  #card { grid-area: card; position: relative; padding: 18px 20px; transition: opacity 0.25s, transform 0.3s; }
  #game.card-collapsed #card { transform: translateX(calc(-100% - 32px)); opacity: 0; pointer-events: none; }
  .card__hide {
    position: absolute; top: 8px; right: 8px; width: 30px; height: 30px; padding: 0;
    font-family: var(--px); font-size: 14px; line-height: 1; background: #fff; color: var(--ink);
    border: 2px solid var(--ink); box-shadow: 2px 2px 0 var(--ink);
  }
  .card-tab {
    position: absolute; left: 0; bottom: 118px; padding: 14px 8px; writing-mode: vertical-rl; transform: rotate(180deg);
    font-family: var(--px); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase;
    background: var(--yellow); color: var(--ink); border: 3px solid var(--ink); border-left: 0; box-shadow: -3px -3px 0 var(--ink);
    pointer-events: auto;
  }
  .card-tab[hidden] { display: none; }
  #game.is-moving #card { opacity: 0; transform: translateY(12px); }
  .card__era { padding-right: 36px; font-family: var(--px); font-size: 9px; text-transform: uppercase; color: var(--muted); }
  #card[data-era='past'] .card__era { color: #b07a1a; }
  #card[data-era='now'] .card__era { color: var(--teal); }
  #card[data-era='future'] .card__era { color: var(--pink); }
  #card[data-era='company'] .card__era { color: var(--purple); }
  .card__badge {
    display: inline-block; margin-top: 8px; font-family: var(--px); font-size: 9px; line-height: 1.4;
    background: var(--yellow); border: 2px solid var(--ink); padding: 5px 7px; box-shadow: 2px 2px 0 var(--ink);
  }
  .card__title { font-size: 16px; margin: 8px 0 6px; overflow-wrap: anywhere; }
  .card__role { font-weight: 700; font-size: 15px; }
  .card__blurb { margin: 6px 0 0; font-size: 15px; line-height: 1.5; }
  .card__links { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 14px; }

  .controls { grid-area: controls; display: flex; gap: 10px; }
  .controls .pxbtn { font-size: 14px; padding: 14px 16px; }
  .controls small { font-size: 9px; }

  #track { grid-area: track; display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; padding: 4px 2px 6px; }
  #track::-webkit-scrollbar { display: none; }
  .dot {
    flex: 1 0 auto; min-width: 58px; font-family: var(--px); font-size: 8px; line-height: 1.2;
    background: rgba(255,255,255,0.75); border: 2px solid var(--ink); padding: 8px 6px; cursor: var(--cur-hand); color: var(--ink);
  }
  .dot--past { background: rgba(255, 241, 214, 0.85); }
  .dot--company { background: rgba(231, 227, 255, 0.85); }
  .dot.is-done { background: #fff; }
  .dot.is-on { background: var(--yellow); box-shadow: 3px 3px 0 var(--ink); transform: translateY(-2px); }
  .dot:hover { background: #fff; }

  #bubbles { position: absolute; inset: 0; pointer-events: none; }
  .bubble {
    position: absolute; left: 0; top: 0; max-width: 220px;
    font-family: var(--px); font-size: 12px; line-height: 1.5; color: var(--ink);
    background: #fff; border: 3px solid var(--ink); padding: 8px 10px; box-shadow: 4px 4px 0 rgba(0,0,0,0.25);
    opacity: 0; animation: pop 0.35s steps(4) forwards; will-change: transform;
  }
  .bubble::after {
    content: ''; position: absolute; left: 50%; bottom: -12px; width: 12px; height: 12px; margin-left: -6px;
    background: #fff; border-right: 3px solid var(--ink); border-bottom: 3px solid var(--ink);
    clip-path: polygon(0 0, 100% 0, 100% 100%);
  }
  @keyframes pop { from { opacity: 0; margin-top: 10px; } to { opacity: 1; margin-top: -12px; } }

  .skip { position: absolute; right: 16px; top: 70px; font-family: var(--px); font-size: 8px; color: var(--ink); opacity: 0.6; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .route-badge { position: absolute; right: 18px; top: 90px; font-family: var(--px); font-size: 8px; color: var(--pink); text-decoration: none; background: #fff; border: 2px solid var(--ink); padding: 5px 7px; box-shadow: 2px 2px 0 var(--ink); }
  /* Card shown after hatching the Easter egg in the world. */
  .hatched { position: absolute; left: 50%; top: 22%; transform: translateX(-50%); width: min(92vw, 380px); text-align: center; animation: pop 0.35s steps(4) forwards; }
  .hatched[hidden] { display: none; }
  .hatched__title { font-family: var(--px); font-size: 13px; margin: 0 0 10px; }
  .hatched__body { margin: 0 0 16px; font-size: 15px; }
  .hatched__btns { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
  .noscript { position: absolute; left: 16px; right: 16px; top: 40%; }
  #game.is-broken::after { content: 'The 3D world could not start on this device.'; position: absolute; top: 45%; left: 0; right: 0; text-align: center; font-family: var(--px); font-size: 12px; }

  @media (max-width: 760px) {
    .dock { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'card card' 'track controls'; gap: 10px; }
    #card { min-width: 0; max-width: 100%; }
    #card { padding: 14px 16px; }
    .card__title { font-size: 13px; }
    .card__blurb { font-size: 14px; }
    .card__role { font-size: 14px; }
    .controls .pxbtn { padding: 12px 12px; }
    .controls small { display: none; }
    .score { top: 70px; }
    .hud__nav .pxbtn { font-size: 8px; padding: 8px 8px; }
    .hud__brand .brand__name { display: none; }
    .bubble { font-size: 9px; max-width: 160px; }
    .skip { top: auto; bottom: 8px; display: none; }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .route-badge { top: 64px; }
  }
</style>
