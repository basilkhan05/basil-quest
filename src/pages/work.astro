---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const products = [
  {
    name: 'Simple Bundles',
    color: '#ff4d6d',
    tint: '#ffe3ec',
    tagline: 'Sell product bundles on Shopify without the operational headaches.',
    points: [
      'Mix-and-match, BOGO, volume and subscription bundles',
      'Inventory and fulfillment sync with 3PLs and ERPs',
      'Works across Shopify POS, Shop, Amazon, TikTok and more',
    ],
    stats: [['25,000+', 'merchants'], ['4.9', 'App Store rating']],
    links: [
      { text: 'simplebundles.com', href: 'https://www.simplebundles.com/' },
      { text: 'App Store', href: 'https://apps.shopify.com/simple-bundles' },
    ],
    art: 'bundles',
  },
  {
    name: 'Simple Discounts',
    color: '#7b61ff',
    tint: '#e7e3ff',
    tagline: 'Mix-and-match, tier and quantity breaks, and volume discounts.',
    points: ['Mix-and-match discounts across products', 'Tier and quantity price breaks', 'Volume discounts that work with bundles'],
    stats: [['5.0', 'App Store rating']],
    links: [{ text: 'App Store', href: 'https://apps.shopify.com/simple-discounts' }],
    art: 'discounts',
  },
  {
    name: 'Freshly Batch Inventory',
    color: '#15c2b0',
    tint: '#e1fbf6',
    tagline: 'Track inventory, product batches and expiry dates.',
    points: ['FEFO and FIFO stock rotation', 'Automatic discounts on stock close to expiry', 'Trace orders to batch level for recalls and audits'],
    stats: [['4.8', 'App Store rating']],
    links: [
      { text: 'freshlycommerce.com', href: 'https://www.freshlycommerce.com/freshly-inventory/' },
      { text: 'App Store', href: 'https://apps.shopify.com/freshly' },
    ],
    art: 'inventory',
  },
];

const customers = ['stanley', 'loop', 'parks-project', 'westman-atelier', 'eightounce'];
---
<Base title="Work" active="work" description="Freshly Commerce builds Shopify apps for bundling, discounts and inventory: Simple Bundles, Simple Discounts and Freshly Inventory.">
  <section class="hero">
    <div class="wrap hero__inner">
      <div>
        <p class="eyebrow">Co-founder &amp; CTO</p>
        <img class="hero__logo" src={`${base}logos/freshly-full.png`} alt="Freshly Commerce" width="512" height="160" />
        <p class="lede">Shopify apps for bundling, discounts and inventory. Used by 20,000+ merchants, including Glossier, STANLEY, Yamaha and Sennheiser.</p>
        <div class="hero__cta">
          <a class="pxbtn" href="https://www.freshlycommerce.com/" target="_blank" rel="noopener">Visit Freshly Commerce</a>
          <a class="pxbtn pxbtn--white" href={`${base}#freshly`}>See it in 3D</a>
        </div>
      </div>
      <div class="hero__art" aria-hidden="true">
        <img class="hero__mark" src={`${base}logos/freshly-mark.png`} alt="" width="256" height="256" />
      </div>
    </div>
  </section>

  <section class="stats wrap" aria-label="At a glance">
    <div class="stat panel pxcorners"><b>20,000+</b><span>Shopify merchants</span></div>
    <div class="stat panel pxcorners"><b>3</b><span>apps, one team</span></div>
    <div class="stat panel pxcorners"><b>4.9</b><span>Simple Bundles rating, 799 reviews</span></div>
    <div class="stat panel pxcorners"><b>2021</b><span>year founded</span></div>
  </section>

  <section class="wrap products">
    <h2>The products</h2>
    {products.map((p) => (
      <article class="product panel" style={`--c:${p.color};--t:${p.tint}`}>
        <div class="product__art">
          {p.art === 'bundles' ? (
            <img src={`${base}logos/simple-bundles.png`} alt="Simple Bundles logo" width="512" height="204" />
          ) : p.art === 'discounts' ? (
            <div class="bigglyph">%</div>
          ) : (
            <div class="crates"><i></i><i></i><i></i><i></i><i></i><i></i></div>
          )}
        </div>
        <div class="product__body">
          <h3>{p.name}</h3>
          <p class="product__tag">{p.tagline}</p>
          <ul>{p.points.map((t) => <li>{t}</li>)}</ul>
          {p.stats && (
            <div class="product__stats">
              {p.stats.map(([n, l]) => <span><b>{n}</b> {l}</span>)}
            </div>
          )}
          <div class="product__links">
            {p.links.map((l) => <a class="pxbtn pxbtn--sm pxbtn--white" href={l.href} target="_blank" rel="noopener">{l.text}</a>)}
          </div>
        </div>
      </article>
    ))}
  </section>

  <section class="wrap shot">
    <img src={`${base}logos/sb-app.png`} alt="A Simple Bundles product page with a bundle in the cart" width="1365" height="620" loading="lazy" />
  </section>

  <section class="wrap brands">
    <p class="eyebrow">Trusted by brands like</p>
    <div class="brands__row">
      {customers.map((c) => <img src={`${base}logos/customers/${c}.svg`} alt={c.replace('-', ' ')} loading="lazy" />)}
    </div>
  </section>

  <section class="wrap cta">
    <div class="panel pxcorners cta__box">
      <h2>Running a Shopify brand?</h2>
      <p>If bundles, discounts or inventory are slowing you down, I want to hear about it.</p>
      <a class="pxbtn pxbtn--pink" href={`${base}contact/`}>Get in touch</a>
    </div>
  </section>
</Base>

<style>
  .hero { background: var(--sky); border-bottom: 3px solid var(--ink); padding: 56px 0 64px; }
  .hero__inner { display: grid; grid-template-columns: 1.4fr 1fr; gap: 32px; align-items: center; }
  .hero__logo { width: min(440px, 100%); height: auto; margin: 16px 0 20px; image-rendering: pixelated; }
  .hero__cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px; }
  .hero__art { display: grid; place-items: center; }
  .hero__mark { width: min(260px, 60vw); height: auto; image-rendering: pixelated; background: #fff; border: 3px solid var(--ink); box-shadow: 10px 10px 0 var(--ink); padding: 20px; animation: bob 3s steps(6) infinite; }
  @keyframes bob { 50% { transform: translateY(-10px) rotate(-2deg); } }

  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: -32px; position: relative; }
  .stat { padding: 16px; display: flex; flex-direction: column; gap: 6px; }
  .stat b { font-family: var(--px); font-size: 20px; }
  .stat span { font-size: 14px; color: var(--muted); }

  .products { padding-top: 64px; display: grid; gap: 28px; }
  .products h2 { margin: 0 0 4px; font-size: 20px; }
  .product { display: grid; grid-template-columns: 260px 1fr; gap: 28px; padding: 0; overflow: hidden; }
  .product__art { background: var(--t); border-right: 3px solid var(--ink); display: grid; place-items: center; padding: 24px; min-height: 220px; }
  .product__art img { width: 100%; height: auto; }
  .product__body { padding: 24px 24px 24px 0; }
  .product h3 { margin: 0 0 10px; font-size: 18px; color: var(--c); text-shadow: 2px 2px 0 var(--ink); }
  .product__tag { font-size: 18px; font-weight: 500; margin: 0 0 12px; }
  .product ul { margin: 0 0 16px; padding: 0; list-style: none; }
  .product li { padding-left: 22px; position: relative; }
  .product li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 10px; height: 10px; background: var(--c); border: 2px solid var(--ink); }
  .product__stats { display: flex; gap: 20px; margin-bottom: 16px; font-size: 14px; }
  .product__stats b { font-family: var(--px); font-size: 14px; }
  .product__links { display: flex; gap: 10px; flex-wrap: wrap; }
  .bigglyph { font-family: var(--px); font-size: 110px; color: var(--c); text-shadow: 6px 6px 0 var(--ink); }
  .crates { display: grid; grid-template-columns: repeat(3, 48px); gap: 6px; }
  .crates i { width: 48px; height: 48px; background: #d9a36b; border: 3px solid var(--ink); box-shadow: inset 0 -10px 0 #9b6b43; }
  .crates i:nth-child(1), .crates i:nth-child(3) { visibility: hidden; }

  .shot { padding-top: 48px; }
  .shot img { width: 100%; height: auto; border: 3px solid var(--ink); box-shadow: 8px 8px 0 var(--ink); background: #fff; }

  .brands { padding-top: 56px; text-align: center; }
  .brands__row { display: flex; flex-wrap: wrap; gap: 32px 48px; align-items: center; justify-content: center; margin-top: 20px; }
  .brands__row img { height: 26px; width: auto; filter: grayscale(1); opacity: 0.85; }

  .cta { padding: 64px clamp(16px, 4vw, 40px) 96px; }
  .cta__box { background: var(--yellow); text-align: center; padding: 40px 24px; }
  .cta__box h2 { margin-top: 0; font-size: 18px; }

  @media (max-width: 760px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__art { display: none; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .product { grid-template-columns: 1fr; gap: 18px; }
    .product__art { border-right: 0; border-bottom: 3px solid var(--ink); min-height: 150px; padding: 20px; }
    .product__body { padding: 0 18px 20px; }
  }
  @media (max-width: 640px) {
    .hero { padding: 32px 0 60px; }
    .hero__logo { margin: 12px 0 16px; }
    .hero__cta { gap: 10px; margin-top: 20px; }
    .hero__cta .pxbtn { flex: 1 1 100%; justify-content: center; }
    .stats { gap: 12px; margin-top: -28px; }
    .stat { padding: 14px 12px; }
    .stat b { font-size: 15px; }
    .stat span { font-size: 13px; line-height: 1.35; }
    .products { padding-top: 44px; gap: 22px; }
    .products h2 { font-size: 16px; }
    .product h3 { font-size: 15px; line-height: 1.4; }
    .product__tag { font-size: 16px; }
    .product li { font-size: 15px; padding-left: 20px; margin-bottom: 4px; }
    .product__stats { flex-wrap: wrap; gap: 8px 16px; }
    .product__links .pxbtn { flex: 1 1 auto; justify-content: center; }
    .bigglyph { font-size: 80px; }
    .shot { padding-top: 36px; }
    .shot img { box-shadow: 4px 4px 0 var(--ink); }
    .brands { padding-top: 40px; }
    .brands__row { gap: 20px 28px; }
    .brands__row img { height: 20px; }
    .cta { padding: 44px 20px 64px; }
    .cta__box { padding: 28px 18px; }
    .cta__box h2 { font-size: 15px; }
  }
</style>
