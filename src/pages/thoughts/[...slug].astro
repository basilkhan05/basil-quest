---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('thoughts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const date = post.data.date.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title={post.data.title} active="thoughts" description={post.data.summary}>
  <article class="wrap page post">
    <a class="back" href={`${base}thoughts/`}>All thoughts</a>
    <p class="eyebrow">{post.data.tag} · {date}</p>
    <h1>{post.data.title}</h1>
    <div class="prose"><Content /></div>
  </article>
</Base>

<style>
  .post { max-width: 720px; }
  .back { font-family: var(--px); font-size: 10px; }
  h1 { font-size: clamp(20px, 3.5vw, 28px); margin: 12px 0 32px; }
  .prose :global(h2) { font-size: 15px; margin-top: 40px; }
  .prose :global(p), .prose :global(li) { font-size: 18px; }
  .prose :global(code) { background: var(--paper-2); padding: 2px 5px; border: 2px solid var(--ink); font-size: 0.9em; }
  .prose :global(blockquote) { margin: 24px 0; padding: 12px 20px; border-left: 6px solid var(--teal); background: #fff; }
</style>
