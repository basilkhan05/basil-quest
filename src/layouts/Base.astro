---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  bare?: boolean;
  active?: string;
  noindex?: boolean;
  jsonld?: Record<string, unknown>;
}
const {
  title,
  description = 'Basil Khan: co-founder and CTO of Freshly Commerce. Where I have been, and where I am going.',
  bare = false,
  active = '',
  noindex = false,
  jsonld,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}og.png`, Astro.site).href;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const fullTitle = title ? `${title} | Basil Khan` : 'Basil Khan';
const links = [
  { href: '', label: 'Play', id: 'home' },
  { href: 'work/', label: 'Work', id: 'work' },
  { href: 'journey/', label: 'Journey', id: 'journey' },
  { href: 'thoughts/', label: 'Thoughts', id: 'thoughts' },
  { href: 'games/', label: 'Arcade', id: 'arcade' },
  { href: 'contact/', label: 'Contact', id: 'contact' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Basil Khan" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@basilakhan" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}sitemap-index.xml`} />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <meta name="theme-color" content="#bdeeff" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    {bare ? (
      <slot />
    ) : (
      <>
        <header class="site-nav">
          <a class="brand" href={base}><span class="brand__mark pxcorners" aria-hidden="true"></span><span class="brand__name">Basil Khan</span></a>
          <nav class="nav-links" aria-label="Main">
            {links.map((l) => (
              <a href={base + l.href} aria-current={active === l.id ? 'page' : undefined}>{l.label}</a>
            ))}
          </nav>
        </header>
        <main>
          <slot />
        </main>
        <div class="lanes" aria-hidden="true"></div>
        <footer class="site-foot">
          <div class="wrap">
            <span>Basil Khan. Waterloo, Ontario.</span>
            <span>
              <a href="https://www.linkedin.com/in/basilkh" target="_blank" rel="noopener">LinkedIn</a> ·
              <a href="https://twitter.com/basilakhan" target="_blank" rel="noopener">Twitter</a> ·
              <a href="https://github.com/basilkhan05" target="_blank" rel="noopener">GitHub</a>
            </span>
          </div>
        </footer>
      </>
    )}
  </body>
</html>
